@charset "UTF-8";

@font-face {
  font-family: "qure";
  src: url("{{ 'qure.woff' | asset_url }}") format("woff");
  font-weight: normal;
  font-style: normal;

}

[data-icon]:before {
  font-family: "qure" !important;
  content: attr(data-icon);
  font-style: normal !important;
  font-weight: normal !important;
  font-variant: normal !important;
  text-transform: none !important;
  speak: none;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

[class^="qure-"]:before,
[class*=" qure-"]:before {
  font-family: "qure" !important;
  font-style: normal !important;
  font-weight: normal !important;
  font-variant: normal !important;
  text-transform: none !important;
  speak: none;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


.qure-arrow-right:before {
  content: "\61";
}
.qure-facebook:before {
  content: "\62";
}
.qure-instagram:before {
  content: "\63";
}
.qure-tik-tok:before {
  content: "\64";
}
.qure-youtube:before {
  content: "\65";
}
.qure-shield-check:before {
  content: "\66";
}
.qure-qure-player:before {
  content: "\67";
}


<link href="{{ 'banner-text.css' | asset_url }}" rel="stylesheet" type="text/css">
<link href="{{ 'theme-fonts.css' | asset_url }}" rel="stylesheet" type="text/css"> 
<div class="qure__section banner-with-text" style="--section-padding-top:80px; --section-padding-bottom:80px;">
  <div class="container">
      <div class="row custom__grid align-items-center" style="--column-gap:60px; --column-gap-mobile:32px;">
            <div class="col-md-6 custom__block">
              {% for block in section.blocks %}
                {% if block.settings.video_url != blank %}
                  <div class="treat_breakouts">                     
                      <wistia-player media-id="{{ block.settings.video_url }}" seo="false" aspect="1.0"></wistia-player>                           
                      <style>
                        wistia-player[media-id='{{ blocks.settings.video_url }}']:not(:defined) {
                            background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/{{ block.settings.video_url }}/swatch');
                            display: block;
                            filter: blur(5px);
                            padding-top: 100.0%;
                        }
                    </style>
                  </div>
                {% endif %}   
              {% endfor %} 
            </div>
          <div class="col-md-6 custom__block">
              <div class="banner-with-text-content">
                {% if section.settings.heading != blank %}
                  <h2 class="banner-text--heading">{{ section.settings.heading }}</h2>
                {% endif %}
                {% if section.settings.text != blank %}
                  <div class="banner-text--des" style="--text-mt: 32px; --text-mb: 32px;">
                    {{ section.settings.text 
                    | replace: '<strong>', '<span>' 
                    | replace: '</strong>', '</span>' }}                  
                  </div>
                {% endif %}
                {% if section.settings.url != blank and section.settings.button != blank %}
                  <a href="{{ section.settings.url }}" class="banner-text--button btn btn--primary w-mob-100">{{ section.settings.button }}</a>
                {% endif %}
              </div>
          </div>
      </div>
  </div>
</div>

<script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>

{% schema %}
  {
    "name": "t:sections.banner_with_text.name",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "t:sections.banner_with_text.settings.heading.name"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "t:sections.banner_with_text.settings.text.name"
      },
      {
        "type": "text",
        "id": "button",
        "label": "t:sections.banner_with_text.settings.button.name",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "url",
        "label": "t:sections.banner_with_text.settings.url.name"
      }
    ],
    "blocks": [
      {
        "type": "video",
        "name": "t:sections.banner_with_text.blocks.video.name",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "video_url",
            "label": "t:sections.banner_with_text.blocks.video.settings.video.name"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.banner_with_text.presets.name"
      }
    ]
  }
  {% endschema %}
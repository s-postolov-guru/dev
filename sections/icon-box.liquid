<div class="qure__shipping  qure__section color-background overflow-hidden"
        style="--section-padding-top:32px;--section-padding-bottom:32px; --section-padding-top-mob:24px;--section-padding-bottom-mob:24px;">
        <div class="container"
            style="--column-gap:60px; --column-gap-mobile:30px;--ctm-width:50px; --ctm-width-mob:30px;">
            <div class="row custom__grid d-none d-lg-flex">
                {% for block in section.blocks %}
                    {% if block.type ==  'slide' %}
                        <div class="col-md-3 col-lg-3 custom__block">
                            <div class="qure_shipping-inner d-flex align-items-center gap-4">
                                <div class="qure_shipping-img ctm-width">
                                    {% if block.settings.image != blank %}
                                        <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.alt_text }}" class="img-fluid" />
                                    {% endif %}
                                </div>
                                {% if block.settings.heading != blank %}
                                    <div class="qure_shipping-content">{{ block.settings.heading }}</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="d-flex d-lg-none">
                <div class="d-flex qure_shipping-scroll">
                    {% for block in section.blocks %}
                        {% if block.type ==  'slide' %}
                            <div class="qure_shipping-inner d-flex align-items-center gap-3 px-15">
                                <div class="qure_shipping-img ctm-width">
                                    {% if block.settings.image != blank %}
                                        <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.alt_text }}" class="img-fluid" />
                                    {% endif %}
                                </div>
                                {% if block.settings.heading != blank %}
                                    <div class="qure_shipping-content fs-16">{{ block.settings.heading }}</div>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% schema %}
{
    "name": "t:sections.test.name",
    "settings": [],
    "blocks": [
    {
        "type": "slide",
        "name": "t:sections.icon_box.name",
        "limit": 4,
        "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.icon_box.blocks.slide.settings.heading.name"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.icon_box.blocks.slide.settings.image.name"
        },
        {
            "type": "select",
            "id": "alt_text",
            "label": "t:sections.icon_box.blocks.slide.settings.alt_text.name",
            "options": [
            {
                "value": "guarantee",
                "label": "Guarantee"
            },
            {
                "value": "shield",
                "label": "Shield"
            },
            {
                "value": "pay-later",
                "label": "Pay Later"
            },
            {
                "value": "results",
                "label": "Results"
            }
            ]
        }
        ]
    }
    ],
    "presets": [
    {
        "name": "t:sections.icon_box.presets.name"
    }
    ]
}
{% endschema %}
<div class="trusted_recom qure__section"
        style="--section-padding-top: 80px; --section-padding-bottom: 80px; --section-padding-top-mob: 10px; --section-padding-bottom-mob: 50px;">
        <div class="container" style="--column-gap:35px; --column-gap-mobile:18px;">
            {% if section.settings.heading != blank %}
                <h2 class="qure__section-heading d-md-none mb-30 text-center">
                  {{ section.settings.heading }}
                </h2>
            {% endif %}
            <div class="row align-items-center custom__grid">
                <div class="col-lg-8 custom__block order-1 order-md-0">
                    <div class="trusted_left mw-680">
                        <div class="section_header py-0 mw-100">
                            <div class="trusted_verified d-none d-md-flex">
                                {% for block in section.blocks %}
                                    {% if block.type == 'badge' and block.settings.image != blank %}
                                        <img src="{{ block.settings.image | image_url }}" alt="">
                                      {% endif %}
                                    {% if block.type == 'badge' and block.settings.badge_text != blank %}
                                        {{ block.settings.badge_text | replace: '<p>', '<p class="p-0">' }}
                                    {% endif %}
                                {% endfor %}           
                            </div>
                            <div class="qure__section-header text-md-start text-center mb-30">
                                {% if section.settings.heading != blank %}
                                    <h2 class="qure__section-heading text-md-start pb-20 d-none d-md-block">{{section.settings.heading}}</h2>
                                {% endif %}
                                {% if section.settings.text != blank %}
                                    {{ section.settings.text 
                                    | replace: '<strong>', '<span style="background:#C7E5DB">' 
                                    | replace: '</strong>', '</span>' }}
                                {% endif %}
                            </div>
                            <div class="trusted_verified d-md-none d-flex mt-3">
                                {% for block in section.blocks %}
                                    {% if block.type == 'badge' and block.settings.image != blank %}
                                        <img src="{{ block.settings.image | image_url }}" alt="">
                                    {% endif %}
                                    {% if block.type == 'badge' and block.settings.badge_text != blank %}
                                        {{ block.badge.settings.badge_text | replace: '<p>', '<p class="p-0">' }}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 custom__block">
                    <div class="qure-filter-cards d-block">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#shower2"
                            class="filter-card-item filter-card-video">
                            <div class="filter-card-video-icon align-items-end px-20 py-10">
                                <div class="align-items-center d-flex justify-content-between w-100">
                                    {% for block in section.blocks %}
                                        {% if block.type == "video" %}
                                          <div class="text-white fs-20">
                                            {{ block.settings.header }}
                                            {% if block.settings.description != blank %}
                                              <span class="fs-18 fw-400">{{ block.settings.description }}</span>
                                            {% endif %}
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    {% for block in section.blocks %}
                                        {% if block.type == "video" and block.settings.play_button != blank %}
                                            <img src="{{ block.settings.play_button | image_url }}" alt="">
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            {% for block in section.blocks %}
                                {% if block.type == "video" and block.settings.preview_image != blank%}
                                    <img src="{{ block.settings.preview_image | image_url }}" alt="shower" class="img-fluid" />
                                {% endif %}   
                            {% endfor %}
                        </a>
                        <!-- modal start -->
                        <div class="modal fade filter-modal" id="shower2" data-bs-backdrop="static"
                            data-bs-keyboard="false" tabindex="-1" aria-labelledby="shower2Label" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-md filter-dialog">
                                <div class="modal-content">
                                    <div class="modal-header border-0">
                                        <button type="button" class="btn btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
                                    </div>
                                    {% for block in section.blocks %}
                                        {% if block.settings.video_url != blank %}
                                            <div class="modal-body">
                                                <style>
                                                    wistia-player[media-id='{{ block.settings.video_url }}']:not(:defined) {
                                                        background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/{{ block.settings.video_url }}/swatch');
                                                        display: block;
                                                        filter: blur(5px);
                                                        padding-top: 177.78%;
                                                    }
                                                </style>
                                                <div class="filter-modal-video">
                                                    <wistia-player media-id="{{ block.settings.video_url }}" seo="false"
                                                        aspect="0.5625"></wistia-player>
                                                </div>
                                            </div>
                                        {% endif %}   
                                    {% endfor %} 
                                </div>
                            </div>
                        </div>
                        <!-- modal end-->
                    </div>
                </div>
            </div>
        </div>
    </div>
<script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>
{% schema %}
    {
      "name": "t:sections.trusted_recom.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.trusted_recom.settings.heading.name"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.trusted_recom.settings.text.name"
        }       
      ],
      "blocks": [
        {
          "type": "video",
          "name": "t:sections.trusted_recom.blocks.video.name",
          "limit": 1,
          "settings": [
            {
                "type": "text",
                "id": "header",
                "label": "t:sections.trusted_recom.blocks.video.settings.header.name"
            }, 
            {
                "type": "richtext",
                "id": "description",
                "label": "t:sections.trusted_recom.blocks.video.settings.description.name"
            },
            {
                "type": "text",
                "id": "video_url",
                "label": "t:sections.trusted_recom.blocks.video.name"
            },
            {
                "type": "image_picker",
                "id": "preview_image",
                "label": "t:sections.trusted_recom.blocks.video.settings.preview_image.name"
            },
            {
                "type": "image_picker",
                "id": "play_button",
                "label": "t:sections.trusted_recom.blocks.video.settings.play_button.name"
            }
          ]
        },
        {
          "type": "badge",
          "name": "t:sections.trusted_recom.blocks.badge.name",
          "limit": 1,
          "settings": [
            {
              "type": "richtext",
              "id": "badge_text",
              "label": "t:sections.trusted_recom.blocks.badge.settings.text.name"
            },
            {
              "type": "image_picker",
              "id": "image",
              "label": "t:sections.trusted_recom.blocks.badge.settings.image.name"
            }  
          ]
        }
      ],
      "presets": [
        {
          "name": "t:sections.trusted_recom.presets.name"
        }
      ]
    }
    {% endschema %}